---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { ui, projectUrl, type Lang } from '../lib/i18n';

interface Props { id: string; data: any; index: number; lang?: Lang; }
const { id, data, index, lang = 'es' } = Astro.props;
const t = ui[lang];
const [l1, l2] = data.repoLabels ?? t.code;
---
<article
  class="project-card reveal tilt group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface"
  data-category={data.category}
  data-id={id}
>
  <div class="relative aspect-[16/9] overflow-hidden border-b border-line">
    {data.cover ? (
      <Image src={data.cover} alt="" widths={[480, 800]} class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-[1.03] group-hover:grayscale-0" />
    ) : (
      <div class="flex h-full w-full items-end justify-between bg-[radial-gradient(120%_120%_at_0%_0%,color-mix(in_srgb,var(--accent)_28%,transparent),transparent_60%)] p-5 grayscale transition duration-500 group-hover:grayscale-0">
        <span class="h-display text-7xl text-fg/20 transition group-hover:text-accent/60">{String(index + 1).padStart(2, '0')}</span>
        <span class="eyebrow">{t.categories[data.category]}</span>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="eyebrow mb-3">{t.categories[data.category]}{data.featured ? ` · ${t.featured}` : ''}</p>
    <h3 class="h-display text-3xl">
      <a href={projectUrl(lang, id)} class="after:absolute after:inset-0 after:content-['']">{data.title}</a>
    </h3>
    <p class="mt-3 text-muted">{data.summary}</p>
    <ul class="mt-5 flex flex-wrap gap-1.5">
      {data.stack.slice(0, 6).map((s: string) => <li class="tag">{s}</li>)}
    </ul>
    <div class="relative z-10 mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6 text-sm">
      {data.repo && <a href={data.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-accent"><Icon name="simple-icons:github" class="h-4 w-4" />{l1}</a>}
      {data.repo2 && <a href={data.repo2} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-accent"><Icon name="simple-icons:github" class="h-4 w-4" />{l2}</a>}
      {data.demo && <a href={data.demo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-accent"><Icon name="lucide:external-link" class="h-4 w-4" />{t.demo}</a>}
    </div>
  </div>
</article>
