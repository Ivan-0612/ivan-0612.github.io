---
import { url } from '../lib/url';
import { ui, type Lang } from '../lib/i18n';
interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = ui[lang];
---
<div id="avatar-wrap" class="relative mx-auto w-fit will-change-transform">
  <figure
    id="avatar"
    class="group relative aspect-[9/16] h-[min(50svh,720px)] md:h-[min(74svh,720px)] overflow-hidden rounded-t-full"
    style="mask-image: radial-gradient(ellipse 75% 85% at 50% 45%, #000 70%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 75% 85% at 50% 45%, #000 70%, transparent 100%);"
  >
    <video
      id="avatar-video"
      class="h-full w-full object-cover grayscale contrast-[1.1] transition-[filter] duration-700 ease-out group-hover:grayscale-0 group-hover:contrast-100 group-focus-within:grayscale-0 group-[.is-color]:grayscale-0 group-[.is-color]:contrast-100"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={url('/media/avatar-poster.webp')}
      aria-label={t.avatarAria}
    >
      <source src={url('/media/avatar.webm')} type="video/webm" />
      <source src={url('/media/avatar.mp4')} type="video/mp4" />
    </video>
  </figure>
  <button
    id="avatar-toggle"
    type="button"
    class="absolute bottom-3 right-0 rounded-full bg-black/60 px-2.5 py-1.5 text-xs text-white opacity-70 transition hover:opacity-100 focus-visible:opacity-100"
    aria-label={t.pause}
    data-label-pause={t.pause}
    data-label-play={t.play}
  >❚❚</button>
</div>
