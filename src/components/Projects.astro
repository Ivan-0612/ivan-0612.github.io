---
import { getProjects } from '../lib/content';
import ProjectCard from './ProjectCard.astro';
import { ui, tr, lurl, projectPath, type Lang } from '../lib/i18n';
interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = ui[lang];

const all = await getProjects(lang);
const categories = [...new Set(all.map((p) => p.data.category))];
---
<section id="proyectos" class="section">
  <div class="container-cv">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">{t.projectsEyebrow}</p>
        <h2 class="h-display h-section mt-4">{t.projectsTitle}</h2>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label={t.filterAria} id="project-filters">
        <button type="button" class="tag chip" data-filter="all" aria-pressed="true">{t.all}</button>
        {categories.map((c) => <button type="button" class="tag chip" data-filter={c} aria-pressed="false">{t.categories[c]}</button>)}
      </div>
    </div>

    <div id="project-grid" class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {all.map((p, i) => (
        <div class:list={['project-item', p.data.featured && 'lg:col-span-1']} data-category={p.data.category}>
          <ProjectCard id={p.id} data={p.data} index={i} lang={lang} />
        </div>
      ))}
    </div>
  </div>
</section>
