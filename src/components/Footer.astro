---
import profile from '../content/profile.json';
import { ui, type Lang } from '../lib/i18n';
interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = ui[lang];
---
<footer class="border-t border-line py-8 text-sm text-muted">
  <div class="container-cv flex flex-wrap items-center justify-between gap-3">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p>{t.footerBuilt} · <a class="underline-offset-4 hover:underline" href={profile.links.github} target="_blank" rel="noopener">GitHub</a></p>
  </div>
</footer>
