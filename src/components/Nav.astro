---
import profile from '../content/profile.json';
import { ui, tr, lurl, type Lang } from '../lib/i18n';
import { url } from '../lib/url';
interface Props { lang?: Lang; alt?: { es: string; en: string }; }
const { lang = 'es', alt = { es: '/', en: '/en/' } } = Astro.props;
const t = ui[lang];
const p = tr(profile, lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
---
<header id="nav" class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/70 backdrop-blur-md">
  <div id="progress" class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent"></div>
  <nav class="container-cv flex h-16 items-center justify-between" aria-label={t.navAria}>
    <a href={lurl(lang, '/#inicio')} class="font-display text-2xl leading-none" aria-label={t.homeAria}>IB</a>
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {t.nav.map(([label, href]) => (
        <li><a href={lurl(lang, '/' + href)} class="transition-colors hover:text-fg">{label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <a href={url(alt[other])} hreflang={other} lang={other} data-set-lang={other} class="btn btn-ghost !px-3 !py-1.5 !text-sm" aria-label={t.switchAria} title={t.switchTo}>{t.switchShort}</a>
      <a href={p.links.cv} download class="btn btn-ghost !py-1.5 !text-sm">{t.cv}</a>
    </div>
  </nav>
</header>
