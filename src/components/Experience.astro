---
import { getCollection } from 'astro:content';
import Timeline from './Timeline.astro';
const experience = await getCollection('experience');
const education = await getCollection('education');
---
<section id="experiencia" class="section">
  <div class="container-cv grid gap-16 md:grid-cols-2">
    <div>
      <p class="eyebrow">04 — Experiencia</p>
      <h2 class="h-display h-section mb-12 mt-4">Dónde he trabajado</h2>
      <Timeline items={experience} />
    </div>
    <div id="estudios">
      <p class="eyebrow">05 — Estudios</p>
      <h2 class="h-display h-section mb-12 mt-4">Cómo me he formado</h2>
      <Timeline items={education} />
    </div>
  </div>
</section>
