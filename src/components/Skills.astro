---
import { getCollection } from 'astro:content';
import { getProjects } from '../lib/content';
import { ui, tr, lurl, type Lang } from '../lib/i18n';
interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = ui[lang];

const groups = (await getCollection('skills'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((g) => ({ ...g, data: { ...tr(g.data, lang), items: g.data.items.map((i) => tr(i, lang)) } }));
const projects = await getProjects(lang);
const titles = Object.fromEntries(projects.map((p) => [p.id, p.data.title]));
const all = groups.flatMap((g) => g.data.items.map((i) => i.name));
---
<section id="habilidades" class="section">
  <div class="container-cv">
    <p class="eyebrow">{t.skillsEyebrow}</p>
    <h2 class="h-display h-section mt-4">{t.skillsTitle}</h2>
    <p class="mt-4 max-w-xl text-muted">{t.skillsIntro}</p>
  </div>

  <div class="marquee mt-12 overflow-hidden border-y border-line py-5" aria-hidden="true">
    <div class="marquee-track flex gap-10 font-display text-3xl text-muted">
      {[...all, ...all].map((n) => <span class="whitespace-nowrap">{n} <span class="text-accent">·</span></span>)}
    </div>
  </div>

  <div class="container-cv mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2">
    {groups.map((g) => (
      <div class="reveal">
        <h3 class="eyebrow mb-4 text-fg">{g.data.group}</h3>
        <ul class="flex flex-wrap gap-2">
          {g.data.items.map((i) => (
            <li>
              <button
                type="button"
                class="chip cursor-pointer rounded-full border border-line px-3.5 py-1.5 text-sm text-muted"
                data-projects={i.projects.join(',')}
                data-note={i.note ?? ''}
                aria-expanded="false"
              >{i.name}</button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div
    id="skill-pop"
    role="status"
    hidden
    class="fixed z-40 w-72 rounded-xl border border-line bg-surface p-4 text-sm shadow-2xl"
    data-titles={JSON.stringify(titles)}
    data-base={lurl(lang, lang === 'en' ? '/projects/' : '/proyectos/')}
    data-one={t.popOne}
    data-many={t.popMany}
  >
    <p id="skill-pop-title" class="font-medium"></p>
    <p id="skill-pop-label" class="eyebrow mt-2"></p>
    <ul id="skill-pop-list" class="mt-1 space-y-1"></ul>
    <p id="skill-pop-note" class="mt-2 text-muted"></p>
  </div>
</section>
