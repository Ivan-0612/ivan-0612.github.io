---
import '@fontsource-variable/geist';
import '@fontsource/instrument-serif';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import profile from '../content/profile.json';
import { url } from '../lib/url';
import { ui, tr, lurl, type Lang } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  theme?: 'light-to-dark' | 'dark';
  lang?: Lang;
  /** Ruta equivalente en cada idioma (para hreflang y el selector ES/EN) */
  alt?: { es: string; en: string };
}
const { lang = 'es', alt = { es: '/', en: '/en/' }, theme = 'light-to-dark' } = Astro.props;
const t = ui[lang];
const p = tr(profile, lang);
const {
  title = `${p.name} · ${p.headline}`,
  description = p.tagline,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (path: string) => new URL(url(path), Astro.site).href;
const enTarget = url(alt.en);
const ogImage = new URL(url('/og-image.png'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: p.headline,
  description: p.tagline,
  inLanguage: lang,
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  url: Astro.site?.href,
  sameAs: [profile.links.github, profile.links.linkedin],
};
---
<!doctype html>
<html lang={t.htmlLang} data-theme={theme === 'dark' ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Si se llega con #ancla desde otra página, se oculta la página hasta colocarla en su sitio
      // (evita ver un instante el inicio antes de saltar a la sección).
      if (location.hash.length > 1) {
        document.documentElement.classList.add('hash-wait');
        setTimeout(function () { document.documentElement.classList.remove('hash-wait'); }, 1800);
      }
    </script>
    <script is:inline define:vars={{ enTarget, auto: lang === 'es' }}>
      // Idioma: si has elegido uno con el botón ES/EN, se respeta; si no, se usa el del navegador.
      // Español si tu navegador lo prefiere; en inglés (u otro idioma) se abre la versión en inglés.
      try {
        if (auto) {
          var pick = localStorage.getItem('lang');
          if (pick !== 'es' && pick !== 'en' && !/bot|crawl|spider|slurp|facebookexternalhit|preview/i.test(navigator.userAgent)) {
            var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'es'];
            pick = 'en';
            for (var i = 0; i < langs.length; i++) {
              var l = String(langs[i]).toLowerCase().slice(0, 2);
              if (l === 'es' || l === 'en') { pick = l; break; }
            }
          }
          if (pick === 'en') location.replace(enTarget + location.hash);
        }
      } catch (e) {}
      document.addEventListener('click', function (ev) {
        var a = ev.target && ev.target.closest && ev.target.closest('a[data-set-lang]');
        if (a) { try { localStorage.setItem('lang', a.getAttribute('data-set-lang')); } catch (e) {} }
      });
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" hreflang="es" href={abs(alt.es)} />
    <link rel="alternate" hreflang="en" href={abs(alt.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(alt.es)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2540" />
    <meta property="og:image:height" content="1249" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">
      {t.skip}
    </a>
    <slot />
    <script is:inline>
      (function () {
        var h = location.hash;
        if (h.length < 2) return;
        var go = function () { var el = null; try { el = document.querySelector(h); } catch (e) {} if (el) el.scrollIntoView({ block: 'start' }); };
        var done = function () { go(); document.documentElement.classList.remove('hash-wait'); };
        go();
        if (document.readyState === 'complete') requestAnimationFrame(done);
        else addEventListener('load', function () {
          var f = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
          f.then(function () { requestAnimationFrame(done); });
        });
      })();
    </script>
    <script>
      import { initSmoothScroll } from '../scripts/smooth-scroll';
      import { initAnimations } from '../scripts/animations';
      import { initAvatar } from '../scripts/avatar';
      initSmoothScroll();
      initAvatar();
      initAnimations();
    </script>
  </body>
</html>
