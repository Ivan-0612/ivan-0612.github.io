---
import '@fontsource-variable/geist';
import '@fontsource/instrument-serif';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import profile from '../content/profile.json';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  theme?: 'light-to-dark' | 'dark';
}
const {
  title = `${profile.name} · ${profile.headline}`,
  description = profile.tagline,
  theme = 'light-to-dark',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  url: Astro.site?.href,
  sameAs: [profile.links.github, profile.links.linkedin],
};
---
<!doctype html>
<html lang="es" data-theme={theme === 'dark' ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">
      Saltar al contenido
    </a>
    <slot />
    <script>
      import { initSmoothScroll } from '../scripts/smooth-scroll';
      import { initAnimations } from '../scripts/animations';
      import { initAvatar } from '../scripts/avatar';
      initSmoothScroll();
      initAvatar();
      initAnimations();
    </script>
  </body>
</html>
